{
  "name": "@portfolio/whatsapp-core",
  "version": "0.2.0",
  "description": "Provider-agnostic WhatsApp messaging core: Meta Cloud API + Twilio adapters, 24h session window, webhook signature verification, inbound normalization, media persistence, and opt-out compliance. Shared dependency for bien, campfire-v2, hablo, mexicasa, cobros.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build && git config core.hooksPath .githooks",
    "secret-scan": "sh scripts/secret-scan.sh --tree"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawrns/whatsapp-core.git"
  },
  "bugs": {
    "url": "https://github.com/lawrns/whatsapp-core/issues"
  },
  "homepage": "https://github.com/lawrns/whatsapp-core#readme",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "pg": "^8.11.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
